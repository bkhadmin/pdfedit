{
  "name": "pdfedit",
  "version": "25691111.1.3",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --win --publish never && node scripts/check-packaged.cjs",
    "release": "node scripts/release.cjs",
    "test": "node test/sign.test.cjs && node test/placement.test.mjs",
    "build:web": "vite build"
  },
  "build": {
    "appId": "local.pdfedit",
    "productName": "PDF Edit",
    "buildVersion": "2569.1111.1.3",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    },
    "publish": {
      "provider": "github",
      "owner": "bkhadmin",
      "repo": "pdfedit"
    }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.7"
  },
  "dependencies": {
    "@signpdf/placeholder-pdf-lib": "^4.0.0",
    "@signpdf/signer-p12": "^4.0.0",
    "@signpdf/signpdf": "^4.0.0",
    "electron-updater": "^6.8.11",
    "node-forge": "^1.4.3",
    "pdf-lib": "^1.17.1"
  }
}
