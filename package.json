{
  "name": "pdfedit",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --win",
    "test": "node test/sign.test.cjs",
    "build:web": "vite build"
  },
  "build": {
    "appId": "local.pdfedit",
    "productName": "PDF Edit",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.png"
    },
    "publish": null
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.7"
  },
  "dependencies": {
    "@signpdf/placeholder-pdf-lib": "^4.0.0",
    "@signpdf/signer-p12": "^4.0.0",
    "@signpdf/signpdf": "^4.0.0",
    "pdf-lib": "^1.17.1"
  }
}
